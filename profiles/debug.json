{
  "$schema": "https://opencode.ai/config.json",
  "model": "codex-subscription/gpt-5.6-sol",
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",
  "default_agent": "sisyphus",
  "instructions": [
    "../AGENTS.md",
    "../prompts/core.md",
    "../prompts/profiles/debug.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000,
    "tail_turns": 4,
    "preserve_recent_tokens": 16000
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16000
  }
}
